# Copy to .env and fill in: cp .env.example .env
# .env is gitignored; this file is committed, so never put a real credential here.
# Commented-out lines show the default. Secrets: openssl rand -hex 24

# ─── Generation mode ────────────────────────────────────────────────────────
# local_only | hybrid | paid_only. Unset = auto: local_only with no provider
# key, hybrid once one is set. paid_only with no key fails at startup.
#GENERATION_MODE=local_only

# ─── YouTube stream (required) ──────────────────────────────────────────────
# RTMP ingest URL from YouTube Studio → Go Live → Stream settings.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Stream key for that broadcast. Treat as a password.
YOUTUBE_STREAM_KEY=

# ─── Redis job queue (required) ─────────────────────────────────────────────
# Master's LAN address, as the workers reach it. No password in the URL.
REDIS_URL=redis://192.168.1.210:6379/0
# Interface Redis is published on. Set 127.0.0.1 if you have no worker on the
# LAN; the default is this master's static address and must exist locally.
#REDIS_BIND=192.168.1.210
# Redis password; workers read it separately so it never travels in a URL.
REDIS_PASSWORD=change-me
# Shared secret a worker's /health endpoint requires in x-worker-secret.
WORKER_SHARED_SECRET=change-me

# ─── Postgres queue store (required) ────────────────────────────────────────
POSTGRES_USER=radio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radio

# ─── Tracks and timing ──────────────────────────────────────────────────────
# Host dir mounted into the containers as /srv/radio/tracks.
#TRACKS_HOST_DIR=./tracks
# Where a container reads/writes tracks (set by Compose; override rarely).
#TRACKS_DIR=/srv/radio/tracks
# Output dir on the Mac worker; mac_claim.py defaults it to the NFS mount.
#MAC_OUTPUT_DIR=/Volumes/radio-tracks
# Head start before a hedge backup starts. Retune: now shorter than one
# LOCAL_MIN_DURATION_SEC generation (measure from generation_stats).
#SAFETY_MARGIN_SEC=120
# Minimum seconds of music per LOCAL track (mac/windows). Range 5-300.
#LOCAL_MIN_DURATION_SEC=90
# Seconds per PAID track. ElevenLabs honours it; Gemini clips are fixed 30s.
#PROVIDER_DURATION_SEC=180

# ─── Prompt moderation (required to accept prompts) ─────────────────────────
# OpenAI moderation key. Intake fails closed without it; the stream still runs.
OPENAI_API_KEY=
# Override only if you proxy the moderation endpoint.
#OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations
# Optional artist/copyright check via any OpenAI-compatible chat endpoint.
# Runs only when all three are set; the keyword block always runs.
#COPYRIGHT_LLM_URL=https://openrouter.ai/api/v1/chat/completions
#COPYRIGHT_LLM_API_KEY=
#COPYRIGHT_LLM_MODEL=

# ─── Operator prompt form ───────────────────────────────────────────────────
# Bind address for the form. Localhost only by default; it has no auth.
#INTAKE_BIND=127.0.0.1
# Seconds one source must wait between prompts. Fails OPEN if Redis is down.
#PROMPT_COOLDOWN_SEC=120

# ─── Optional paid providers ────────────────────────────────────────────────
# Setting either key is consent to spend money in hybrid mode.
#ELEVENLABS_API_KEY=
#GEMINI_API_KEY=
#ELEVENLABS_MODEL=music_v2_5
# lyria-3-clip-preview is a fixed 30s clip; lyria-3.5 makes full songs.
#GEMINI_MODEL=lyria-3-clip-preview
# Seed the credit balance only if the live lookup fails (key needs user_read).
#ELEVENLABS_CREDIT_BALANCE=
# How often the provider-worker re-reads the ElevenLabs balance.
#PROVIDER_QUOTA_REFRESH_SEC=300
# Spend cap for pay-as-you-go Gemini Lyra. Unset = no cap (open question #7).
#GEMINI_LYRA_SPEND_CAP_USD=

# ─── Status dashboard ───────────────────────────────────────────────────────
# Bind address for http://127.0.0.1:8081. READ-ONLY but has NO AUTH.
#STATUS_BIND=127.0.0.1
# Queue depth that turns the queue tile amber.
#STATUS_QUEUE_WARN=10
# Moderation reject rate (0-1) that turns the moderation tile amber.
#STATUS_REJECT_WARN=0.5
# Response cache, so extra tabs cost nothing.
#STATUS_CACHE_SEC=3

# ─── YouTube Live Chat intake (the public prompt path) ──────────────────────
# Unset = chat-intake idles; the stream and the form are unaffected.
# YouTube Data API v3 key. Reading chat needs only this.
#YOUTUBE_DATA_API_KEY=
# Video id of the live broadcast (the v=... in its watch URL).
#YOUTUBE_VIDEO_ID=
# Chat id, if you already know it (skips resolving it from the video).
#YOUTUBE_LIVE_CHAT_ID=
# Poll floor in seconds; each poll costs 5 of 10,000 daily units. 60 ≈ 7,200/day.
#CHAT_MIN_POLL_SEC=60
# Optional replies to chatters need all three OAuth values (20 units each).
# Get them with: python3 queue/youtube_oauth_setup.py
#YOUTUBE_OAUTH_CLIENT_ID=
#YOUTUBE_OAUTH_CLIENT_SECRET=
#YOUTUBE_OAUTH_REFRESH_TOKEN=
# Hourly reply cap, so a spammer cannot drain the quota.
#CHAT_REPLY_BUDGET_PER_HOUR=60
