# Template for .env — copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored; this file is committed and must never contain a real
# credential. Per design spec Section 1.5, every path, connection string, and
# credential is supplied via environment so the only difference between the
# macOS dev machine and the Linux production box is this file's contents.
#
# Sections below are grouped by when the plan actually needs them. Anything
# marked for a later sprint is commented out — uncomment it on the day it is
# wired up, not before.


# ─── Sprint 1 / Day 1 — YouTube RTMP push ────────────────────────────────────
# From YouTube Studio → Create → Go Live → Stream settings.
# Use an UNLISTED test stream for all of Sprint 1; the real channel's key does
# not appear here until Day 18.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=


# ─── Sprint 2 — DELL worker, Redis, NFS ──────────────────────────────────────
# Private direct-link subnet from design spec Section 3.5 (master .1, DELL .2).
#REDIS_URL=redis://192.168.50.1:6379/0
#REDIS_PASSWORD=
# Shared secret for the worker's own endpoints (LAN-only, but still authed).
#WORKER_SHARED_SECRET=
#TRACKS_DIR=/srv/radio/tracks


# ─── Sprint 3 — Postgres + first paid provider ───────────────────────────────
#POSTGRES_USER=radio
#POSTGRES_PASSWORD=
#POSTGRES_DB=radio
#DATABASE_URL=postgresql://radio:@postgres:5432/radio
#ELEVENLABS_API_KEY=


# ─── Sprint 4 — prompt moderation ────────────────────────────────────────────
#OPENAI_API_KEY=


# ─── Sprint 5 — remaining providers ──────────────────────────────────────────
#STABLE_AUDIO_API_KEY=
#REPLICATE_API_TOKEN=
#MUBERT_API_KEY=


# ─── Sprint 6 — YouTube Live Chat intake ─────────────────────────────────────
#YOUTUBE_DATA_API_KEY=
