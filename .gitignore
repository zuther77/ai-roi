# Secrets — never commit. Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local data / generated media
*.db
*.sqlite
*.sqlite3
tracks/

# Filler pool: audio files, the SQLite database and the now-playing file are
# all runtime state. Same pattern as test-assets — keep the directory and its
# README in git, keep everything else out.
filler-pool/*
!filler-pool/README.md

# Audio and images stay out of git (they are large, and some are only
# licensed for local use) but the directory and its README are tracked so a
# fresh clone knows what belongs here.
test-assets/*
!test-assets/README.md
# Host-visible structured logs (Day 3). Keep the README; ignore runtime files.
logs/*
!logs/README.md
*.log

# OS cruft
.DS_Store
