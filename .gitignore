# Secrets — never commit. Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local data / generated media
*.db
*.sqlite
*.sqlite3
filler-pool/audio/
tracks/

# Audio and images stay out of git (they are large, and some are only
# licensed for local use) but the directory and its README are tracked so a
# fresh clone knows what belongs here.
test-assets/*
!test-assets/README.md
logs/
*.log

# OS cruft
.DS_Store
